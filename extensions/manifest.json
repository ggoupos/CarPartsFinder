{
  "manifest_version": 3,
  "name": "Parts Search — B2B Bridge",
  "key": "",
  "version": "1.0.0",
  "description": "Runs part searches on B2B sites using your already-logged-in browser session, and returns results to the Parts Search app.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://autospark.shop/*",
    "https://hatziligos.com.gr/*",
    "*://*.elkar.gr/*",
    "*://*.car.gr/*",
    "*://*.intercars.eu/*",
    "https://*.supabase.co/*" 
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*"
    ]
  }
}