@echo off
chcp 65001 >nul
title Εργαλειο Αναζητησης Ανταλλακτικων
color 0B

:: 1. Ελέγχει αν το πρόγραμμα τρέχει ΗΔΗ
tasklist /FI "IMAGENAME eq node.exe" 2>NUL | find /I /N "node.exe">NUL
if "%ERRORLEVEL%"=="0" (
    :: Αν τρέχει ήδη, απλά ανοίγει μια νέα καρτέλα στον browser και κλείνει αμέσως!
    start http://localhost:3000
    exit
)

:: 2. Αν δεν τρέχει, εμφανίζει ένα φιλικό παράθυρο
echo =======================================================
echo         ΕΡΓΑΛΕΙΟ ΑΝΑΖΗΤΗΣΗΣ ΑΝΤΑΛΛΑΚΤΙΚΩΝ
echo =======================================================
echo.
echo  Το προγραμμα λειτουργει κανονικα!
echo.
echo  - Μπορειτε να ελαχιστοποιησετε (-) αυτο το παραθυρο.
echo  - Μην το κλεισετε οσο ψαχνετε ανταλλακτικα.
echo.
echo  ΓΙΑ ΤΕΡΜΑΤΙΣΜΟ: Απλα πατηστε το [X] πανω δεξια.
echo.
echo =======================================================

:: Ανοίγει την πρώτη καρτέλα στον browser
start http://localhost:3000

:: Ξεκινάει τον server μέσα σε ΑΥΤΟ το παράθυρο. 
:: Όταν ο πελάτης πατήσει το Χ, ο server κλείνει αυτόματα.
"%~dp0bin\node.exe" server.js